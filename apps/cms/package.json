{
  "name": "@lapuertahostels/cms",
  "private": true,
  "version": "0.0.0-unknown",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/with-build-env.mjs pnpm run build:configured",
    "prod-preview": "pnpm build && mv .next/static .next/standalone/.next/static && cross-env PORT=3001 node .next/standalone/server.js",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation PORT=3001 next dev --turbopack",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "touch \"src/app/(payload)/admin/importMap.js\" && node scripts/with-build-env.mjs pnpm exec cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "node scripts/with-build-env.mjs pnpm exec cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "test": "vitest run",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation PORT=3001 next start",
    "check-format": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "build:configured": "pnpm generate:importmap && cross-env NODE_OPTIONS=--no-deprecation next build",
    "media": "payload run src/media/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@lapuertahostels/live-preview": "workspace:../../libs/live-preview",
    "@lapuertahostels/payload-types": "workspace:../../libs/payload-types",
    "@payloadcms/db-mongodb": "^3.94.1",
    "@payloadcms/email-resend": "^3.94.1",
    "@payloadcms/next": "^3.94.1",
    "@payloadcms/richtext-lexical": "^3.94.1",
    "@payloadcms/storage-s3": "^3.94.1",
    "@payloadcms/translations": "^3.94.1",
    "@payloadcms/ui": "^3.94.1",
    "bson": "^6.10.4",
    "cross-env": "^10.1.0",
    "deepl-node": "^1.29.0",
    "jsdom": "29.1.1",
    "next": "~16.4.6",
    "openai": "^6.38.0",
    "payload": "^3.94.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^9.32.0",
    "eslint-config-next": "~16.4.6",
    "prettier": "3.8.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.1.6",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
